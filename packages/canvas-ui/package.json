{
  "name": "@agent-test/canvas-ui",
  "version": "0.0.1",
  "private": true,
  "description": "画布编辑区（react-flow 节点编辑器）的共享 UI：节点 / 连线 / 面板 / 工具条 + 平台适配层（CanvasPlatformProvider）与三语字典，web / desktop 共用。直接发 TS 源码，由使用方的打包器编译",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./messages": "./src/i18n/messages.ts",
    "./canvas.css": "./src/canvas.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@agent-test/canvas-schema": "workspace:*",
    "@agent-test/ui": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.17.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tanstack/react-query": "^5.100.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
