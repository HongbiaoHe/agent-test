{
  "name": "@agent-test/canvas-schema",
  "version": "0.0.1",
  "private": true,
  "description": "画布的共享类型与纯逻辑：节点 / 连线 / 操作 / 增量、连线规则、上游素材收集、注入给 agent 的画布文本（后端、web、desktop 三方共用）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test src/*.test.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3"
  }
}
