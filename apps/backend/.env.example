PORT=3101
CORS_ORIGIN=http://localhost:3100
DATABASE_URL=mysql://root:dev@localhost:3306/agent
REDIS_URL=redis://localhost:6379
GOOGLE_GENAI_MODEL=gemini-3.8-flash
# 你的 Gemini API key，留空待填
GOOGLE_API_KEY=
# WebAuthn / Passkey：RP_ID=可访问域名（隧道演示填隧道域名，本机填 localhost），ORIGIN 带协议
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AgentSpark
WEBAUTHN_ORIGIN=http://localhost:3100

# JWT Auth Secret (Required, backend will fail to start if not provided)
AUTH_JWT_SECRET=

# Resend API Key for sending verification code email (Replace re_xxxxxxxxx with your real key)
RESEND_API_KEY=re_xxxxxxxxx

# ── 技能（skills）──
# 内置技能目录（缺省 apps/backend/skills）与用户安装技能根目录（缺省 apps/backend/data/skills）
# SKILLS_DIR=
# SKILLS_DATA_DIR=

# ── 云沙箱（技能脚本 execute 执行；所选提供方的 key 留空则回退无执行能力的 StateBackend）──
# 默认沙箱提供方：daytona | e2b（缺省 daytona）。用户可在 /settings/sandbox 覆盖（及闲置/删除时长）；
# 切换后各自的沙箱互不可见（工作区文件不迁移）。
SANDBOX_PROVIDER=daytona
# Daytona：注册 https://app.daytona.io 获取（免费层 $200 额度）
DAYTONA_API_KEY=
# Daytona 账户是否允许按沙箱设置出站网络（Tier 3+ 才支持；Tier 1–2 由 Daytona 组织策略统一管理）。
# 缺省关闭：用 Daytona 时出站设置不生效、设置页禁用相应选项。
# DAYTONA_NETWORK_CONTROL=1
# E2B：注册 https://e2b.dev 获取。闲置 5 分钟自动暂停（暂停态永久保留、不自动删除），不支持图形桌面
E2B_API_KEY=

# ── 生图 / 生视频（统一走 aigc 生成服务：模型清单、接单、回调都经它）──
# 资产目录缺省 apps/backend/data/media
# MEDIA_DATA_DIR=
AIGC_BASE_URL=
AIGC_TOKEN=
# 我方公网基址：aigc 要能回调我们、也要能下载我们给的参考图。
# 留空则自动探测本机 ngrok 隧道（pnpm tunnel）；部署环境显式配置。
# PUBLIC_BASE_URL=https://api.example.com
