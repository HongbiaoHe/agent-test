generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  tenantId                 String
  tenant                   Tenant          @relation(fields: [tenantId], references: [id])
  authenticators           Authenticator[]
  /// 沙箱设置（/settings/sandbox）。提供方：daytona | e2b；null = 跟随 env SANDBOX_PROVIDER
  sandboxProvider          String?
  /// 闲置多少分钟后自动停机（Daytona）/ 暂停（E2B）；null = 默认 5
  sandboxIdleMinutes       Int?
  /// 停机后多少分钟自动删除（仅 Daytona；-1 = 永不删除）；null = 默认 10
  sandboxAutoDeleteMinutes Int?
  /// 出站网络：open | allowlist | blocked；null = 默认 open
  sandboxNetworkMode       String?
  /// 出站白名单（string[]：域名 / IP / CIDR），仅 allowlist 模式生效
  sandboxNetworkAllowList  Json?
  /// 沙箱端口公网地址是否免鉴权访问（仅 E2B，创建时生效）；null = 默认 false（需鉴权）
  sandboxPublicTraffic     Boolean?
  createdAt                DateTime        @default(now())

  @@index([tenantId])
}

/**
 * WebAuthn/Passkey 凭据（一个用户可注册多把）。
 */
model Authenticator {
  id           String    @id @default(cuid())
  credentialId String    @unique // base64url 编码的 credential ID，登录时按此查找
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  publicKey    Bytes // COSE 公钥
  counter      Int       @default(0) // 签名计数器，防重放
  transports   String? // 逗号拼接，如 "internal,hybrid"
  aaguid       String? // 认证器厂商标识（注册时由 WebAuthn 返回），用于解析来源名
  deviceType   String? // singleDevice | multiDevice（来自 credentialDeviceType）
  backedUp     Boolean   @default(false) // 是否云同步备份（来自 credentialBackedUp）
  lastUsedAt   DateTime? // 最后一次用此 passkey 登录的时间；从未使用为 null
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Conversation {
  id            String    @id @default(cuid())
  goal          String    @db.Text
  status        String    @default("queued") // queued | running | waiting_approval | done | failed | stopped
  model         String? // 本会话回答模型（前端可切换）；为空则 worker 回退 env/默认
  // 思考深度档位（auto/off/on/low/medium/high）；为空 = auto（跟随模型默认）。
  // 各家能力不对等（deepseek 仅开关、gemini 支持分级），映射见 agent/thinking-level.ts
  thinkingLevel String?
  // 用户重命名的标题；NULL = 未命名，侧栏/顶栏回退显示 goal（首条消息）
  title         String?   @db.VarChar(200)
  // 侧栏置顶时刻；NULL = 未置顶。置顶的排在前面，按置顶时刻倒序
  pinnedAt      DateTime?
  // 软删除时刻；非 NULL = 已删除：列表 / 详情 / 订阅 / 续聊都不再可见，数据留库可恢复
  deletedAt     DateTime?
  tenantId      String
  userId        String
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // user | assistant | tool
  type           String // message | tool_call | tool_result | plan | result | control_request
  content        Json
  seq            Int
  createdAt      DateTime     @default(now())

  @@index([conversationId, seq])
}

/**
 * Spark 对话 agent 的 token 用量明细：每次模型调用一行（画布那套 CanvasTokenUsage 的对话版）。
 * 不建 Run 表：一「轮」= 触发它的那条用户消息（turnMessageId），审批后续跑天然归到同一轮。
 */
model ConversationTokenUsage {
  id                  String   @id @default(cuid())
  conversationId      String
  // 触发本轮的用户消息（Message.id）：报表按它分轮，目标文本也取它
  turnMessageId       String
  // 产生这次用量的 AIMessage id：checkpointer 恢复会把历史 AIMessage 重新 emit 到 updates 流，
  // 落库 + 唯一约束让重放天然幂等（同 CanvasTokenUsage.messageId）。模型没给 id 时为空。
  messageId           String?
  model               String
  inputTokens         Int
  outputTokens        Int
  totalTokens         Int
  // 缓存明细（⊆ inputTokens）：命中读取 / 写入缓存
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  createdAt           DateTime @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

model Approval {
  id             String   @id @default(cuid())
  conversationId String
  decision       String // approve | edit | reject | respond | timeout
  payload        Json // 完整 decisions / 上下文
  decidedAt      DateTime @default(now())

  @@index([conversationId])
}

/**
 * 一个"生成位"= 对话里的一张媒体卡片；重新生成在同一 generation 下叠 version。
 */
model MediaGeneration {
  id             String         @id @default(cuid())
  conversationId String
  userId         String
  type           String // image | video
  versions       MediaVersion[]
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

/**
 * 一次生成尝试；历史版本永不删除（用户要求重生成后仍可看旧版）。
 */
model MediaVersion {
  id                  String          @id @default(cuid())
  generationId        String
  generation          MediaGeneration @relation(fields: [generationId], references: [id])
  prompt              String          @db.Text
  // 本次生成用的 aigc 模型别名（如 seedream-4.5）；拼接产物为 ffmpeg-concat。
  model               String
  // aigc 渠道（byteplus | fal | google | kie）；本地拼接为 null。
  channel             String?
  // 本次提交给 aigc 的档位参数（aspect_ratio / resolution / duration / with_audio 等，
  // 形状 Record<string,string>）。用 Json 存：维度随模型而变，只整体读写。
  params              Json?
  // aigc 侧的 task_id：回调按它反查本版本（回调 body 只带 task_id 与 metadata）。
  providerTaskId      String?
  status              String          @default("queued") // queued | generating | done | failed
  // 参考图：引用本会话此前生成的图片版本 id 数组（图生图多张 / 视频取首张作首帧）。
  // 用 Json 存数组：版本数 ≤4、只整体读写、不需要按元素查询，Json 比关联表更简单（YAGNI）。
  referenceVersionIds Json? // string[] | null
  // aigc 产物的永久 CDN 地址（output_data.image_url / video_url），前端直接从 CDN 取。
  // 与 filePath 二选一：aigc 产物只存 url，本地 ffmpeg 拼接产物只存 filePath。
  url                 String?         @db.Text
  filePath            String? // MEDIA_DATA_DIR 下相对路径，如 <versionId>.png / .mp4
  error               String?         @db.Text
  // 画布测试模式（Mock）产出的占位素材：不调 aigc，本地渲染。真实生成不能引用它作参考，
  // 由它拼出来的成片同样记为 mock（见 MediaService）。
  mock                Boolean         @default(false)
  createdAt           DateTime        @default(now())
  completedAt         DateTime?
  // 附件理解结果（发送时自动分析，见 media-analysis 模块）；一个版本至多一份
  analysis            MediaAnalysis?

  @@index([generationId])
  @@index([providerTaskId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 画布工作流（独立模块：独立会话/运行/消息/节点/边/操作日志，与上面的
// Conversation/Message 互不影响。设计见 docs/superpowers/specs/2026-07-22-canvas-workflow-agent-design.md）
// ─────────────────────────────────────────────────────────────────────────────

/**
 * 画布会话 = 一块画布 + 一条独立的 agent 对话线程（thread_id = 本 id）。
 */
model CanvasSession {
  id            String    @id @default(cuid())
  title         String    @default("未命名画布")
  // 列表置顶时刻；NULL = 未置顶。置顶的排在前面，按置顶时刻倒序
  pinnedAt      DateTime?
  status        String    @default("idle") // idle | queued | running | waiting_approval | done | failed | stopped
  model         String? // 本会话 agent 模型；空则 worker 回退默认
  // 思考深度档位（auto|off|on|low|medium|high）；空 = 跟随模型默认。
  // 各家能力不对等（deepseek 仅开关、gemini 支持分级），映射见 agent/thinking-level.ts
  thinkingLevel String?

  // 敏感操作的审批模式：review(默认，破坏性/消耗性操作暂停等用户确认) | auto(全自动，不打断)。
  // 存会话上而不是每条消息：这是"这块画布怎么跑"的偏好，跨轮保持。
  approvalMode String?

  // 测试模式（Mock）：开启时本画布触发的生成不调 aigc，产出本地占位素材（以触发那一刻为准）。
  // 只在 CANVAS_MOCK_MEDIA_ENABLED 打开的环境可用。
  mockMedia Boolean @default(false)
  tenantId  String
  userId    String

  // 乐观并发根版本 = 最新结构 op 的 seq。任一结构变更（增删节点/边、改节点 data）在同一
  // 事务里自增；用户空闲期提交编辑时带上它做 CAS 冲突检测。位置(x/y) LWW 不占此版本。
  revision Int @default(0)

  // 用户「加入对话」圈定的节点 id 数组（JSON string[]）。非空时，注入给 agent 的画布状态
  // 只列这些节点及其相邻连线——大画布上用户往往只想让 agent 动其中几张卡。
  // 空 / null = 关注整块画布（默认）。
  focusNodeIds Json?

  // 重放给 agent 的历史起点（CanvasMessage.seq）。**钉住**而非每轮按窗口末尾倒数，
  // 否则消息一涨裁剪点就平移，整段前缀跟着变、prompt cache 全废（见 processor.loadHistory）。
  historyBaseSeq Int @default(0)

  runs     CanvasRun[]
  messages CanvasMessage[]
  nodes    CanvasNode[]
  edges    CanvasEdge[]
  ops      CanvasOp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/**
 * 一次 harness agent 执行（一级实体：一个画布可多次 Run）。承载运行状态、触发目标、
 * token 累计与起止时间；长跑（可能 >1h）的会计与审计单元。
 */
model CanvasRun {
  id        String        @id @default(cuid())
  sessionId String
  session   CanvasSession @relation(fields: [sessionId], references: [id])
  status    String        @default("queued") // queued | running | waiting_approval | done | failed | stopped
  trigger   Json // 触发本次运行的用户消息/目标
  model     String?
  error     String?       @db.Text

  // 本次运行累计 token（每次模型调用累加；明细见 CanvasTokenUsage）
  promptTokens        Int @default(0)
  completionTokens    Int @default(0)
  totalTokens         Int @default(0)
  // 输入 token 里命中提示缓存的部分（cacheRead ⊆ promptTokens）与写缓存的部分。
  // 本次升级前的历史 run 无缓存数据，按 0 计（命中率会偏低）。
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([sessionId])
}

/**
 * token 用量明细：每次模型调用一行（可审计、可按 run/session/模型聚合）。
 * model 记录**该次调用的真实模型**（优先取响应里的模型名，取不到用本次运行请求的模型）。
 */
model CanvasTokenUsage {
  id                  String   @id @default(cuid())
  sessionId           String
  runId               String
  // 产生这次用量的 AIMessage id。checkpointer 恢复时会把历史 AIMessage 重新 emit 到 updates 流，
  // 跨 run 的内存去重集合拦不住 → 同一次模型调用被反复记账（实测同 session 三个 run 各重放前 17 条，
  // 且 cacheRead 记为历史原值 0，既虚高账单又拉低命中率）。落库 + 唯一约束让重放天然幂等。
  // 可空：升级前的历史行无此值。
  messageId           String?
  model               String
  inputTokens         Int
  outputTokens        Int
  totalTokens         Int
  // 缓存明细（⊆ inputTokens）：命中读取 / 写入缓存。历史行为 0（升级前无此数据）。
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  createdAt           DateTime @default(now())

  @@unique([sessionId, messageId])
  @@index([sessionId])
  @@index([runId])
}

/**
 * 画布 agent 的对话消息（结构同 Message，但独立表，互不影响）。
 */
model CanvasMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   CanvasSession @relation(fields: [sessionId], references: [id])
  runId     String? // 归属的运行（可空：兼容跨轮）
  role      String // user | assistant | tool
  type      String // message | tool_start | tool_end | plan_update | control_request | result | error
  content   Json
  seq       Int
  createdAt DateTime      @default(now())

  @@index([sessionId, seq])
}

/**
 * 画布节点（物化当前态）。type ∈ image_upload | image_gen | video_gen | video_concat。
 * 扁平强类型可空列（非 Json blob），按 type 填不同列：
 * - image_upload: assetPath（MVP 模拟上传占位）
 * - image_gen   : prompt, mediaGenerationId（状态靠 JOIN MediaVersion 算）
 * - video_gen   : prompt, mediaGenerationId
 * - video_concat: mediaGenerationId（源视频按入边顺序取，无自有字段）
 * ⚠️ 曾有 type='text' 的提示词节点，已下线（提示词改为生成节点自己的 prompt 字段）。
 * 历史行仍留在表里，未做数据迁移；快照层按 isCanvasNodeType 过滤，不会进到接口。
 * version：节点级乐观锁，改 data 时自增；位置(x/y)走 LWW 不占版本。
 */
model CanvasNode {
  id        String        @id @default(cuid())
  sessionId String
  session   CanvasSession @relation(fields: [sessionId], references: [id])
  type      String
  x         Float         @default(0)
  y         Float         @default(0)

  label             String? // 展示用标题（可选）
  prompt            String? @db.Text // image_gen / video_gen 提示词
  assetPath         String? // image_upload 已上传资产（MVP 模拟占位）
  mediaGenerationId String? // 生成节点触发后回填；状态/资产靠 JOIN MediaVersion

  // 生成节点（image_gen / video_gen）选定的 aigc 模型与档位参数。
  // 空 = 用该类型的默认模型（aigc 目录里的第一个，见 aigc/aigc.catalog.ts）。
  // 存在节点上而非会话上：同一块画布里不同卡片常要用不同模型对比效果。
  mediaChannel String?
  mediaModel   String?
  mediaParams  Json? // Record<string,string>

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

/**
 * 画布连线（工作流有向边）。source/target 为 CanvasNode.id。
 */
model CanvasEdge {
  id        String        @id @default(cuid())
  sessionId String
  session   CanvasSession @relation(fields: [sessionId], references: [id])
  source    String
  target    String
  // 同一终点的入边顺序（0 起）：拼接节点按它决定成片顺序，生成节点按它给参考素材编号。
  // 新边接在末尾；重排改它（reorder_inputs op），不靠创建时间——同一步并发连线的落库先后不可控
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([sessionId, source, target])
  @@index([sessionId])
}

/**
 * 操作日志（事件源，追加式）：每次结构变更（agent 或 user）追加一条，seq 单调递增 =
 * session.revision。用于审计 / 回放 / 顺序仲裁。位置 move 不进日志（presentation, LWW）。
 */
model CanvasOp {
  id        String        @id @default(cuid())
  sessionId String
  session   CanvasSession @relation(fields: [sessionId], references: [id])
  seq       Int // = 变更后 session.revision
  actor     String // agent | user
  op        Json // { op: add_node|update_node|remove_node|add_edge|remove_edge, ... }
  createdAt DateTime      @default(now())

  @@unique([sessionId, seq])
}

/**
 * 用户安装的技能（内置技能不入库）。落盘目录 SKILLS_DATA_DIR/<userId>/<name>/。
 */
/// 画布 agent 的用户技能（与主 agent 的 Skill 表分开：画布 agent 没有沙箱，技能只是文本工作流说明）。
/// 内置技能随代码发布在磁盘 canvas-skills/，不进这张表；这里只存用户自己的（多由 skills-creator 让 agent 写出）。
model CanvasSkill {
  id          String   @id @default(cuid())
  userId      String
  name        String // Agent Skills 规范：小写字母/数字/连字符，≤64
  description String   @db.Text
  content     String   @db.MediumText // 完整 SKILL.md（含 frontmatter）
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  source      String // 如 "github:anthropics/skills#document-skills/docx@main"
  userId      String // 非空：MySQL 可空唯一键允许重复 NULL，不留可空层（见设计文档 §2）
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

/// 附件理解：用户发送的图片 / 视频 / 音频由视觉模型分析出的结构化描述，按版本一一对应。
/// 发送时自动分析（media-analyze 队列），canvas agent 开跑前注入摘要，细节经 get_media_analysis 工具按需取。
/// 同一版本只分析一次：重复发送同一附件直接复用。
model MediaAnalysis {
  id           String       @id @default(cuid())
  versionId    String       @unique
  version      MediaVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status       String       @default("pending") // pending | done | failed | skipped
  // 一句话摘要（注入 agent 上下文与前端展示）
  summary      String?      @db.Text
  // 结构化细节（形状随素材类型而变，见 media-analysis.schema.ts），只整体读写
  detail       Json?
  // 做分析的模型
  model        String?
  error        String?      @db.Text
  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
